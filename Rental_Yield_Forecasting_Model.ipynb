      "source": [
        "import pandas as pd\n",
        "\n",
        "def forecast_rental_yield(purchase_price, gross_monthly_rent, monthly_hoa_levies,\n",
        "                          management_fee_pct=0.08, annual_vacancy_rate=0.05,\n",
        "                          annual_maintenance_pct=0.02):\n",
        "    \"\"\"\n",
        "    Calculates Gross and Net Rental Yields for luxury clusters in this case The Jacobs, Avondale.\n",
        "    \"\"\"\n",
        "    gross_annual_rent = gross_monthly_rent * 12\n",
        "    effective_gross_income = gross_annual_rent * (1 - annual_vacancy_rate)\n",
        "\n",
        "    annual_hoa = monthly_hoa_levies * 12\n",
        "    annual_management = effective_gross_income * management_fee_pct\n",
        "    annual_maintenance = purchase_price * annual_maintenance_pct\n",
        "\n",
        "    total_operating_expenses = annual_hoa + annual_management + annual_maintenance\n",
        "    net_operating_income = effective_gross_income - total_operating_expenses\n",
        "\n",
        "    gross_yield = (gross_annual_rent / purchase_price) * 100\n",
        "    net_yield = (net_operating_income / purchase_price) * 100\n",
        "\n",
        "    return {\n",
        "        \"Purchase Price\": f\"${purchase_price:,.2f}\",\n",
        "        \"Gross Annual Rent\": f\"${gross_annual_rent:,.2f}\",\n",
        "        \"Effective Gross Income (adj. vacancy)\": f\"${effective_gross_income:,.2f}\",\n",
        "        \"Total Annual OpEx (HOA + Mgmt + Maint)\": f\"${total_operating_expenses:,.2f}\",\n",
        "        \"Net Operating Income (NOI)\": f\"${net_operating_income:,.2f}\",\n",
        "        \"Gross Rental Yield (%)\": f\"{gross_yield:.2f}%\",\n",
        "        \"Net Rental Yield (%)\": f\"{net_yield:.2f}%\"\n",
        "    }\n",
        "\n",
        "# Parameters tuned for a 4-Bed Unit at The Jacobs, Avondale\n",
        "jacobs_forecast = forecast_rental_yield(\n",
        "    purchase_price=350000,       # Market price for a 4-bed unit at The Jacobs\n",
        "    gross_monthly_rent=2400,     # Estimated luxury rental in Avondale\n",
        "    monthly_hoa_levies=250,      # Covering shared pool, gym, security, borehole\n",
        "    management_fee_pct=0.08,     # 8% standard management agency fee\n",
        "    annual_vacancy_rate=0.05,    # 5% vacancy allowance\n",
        "    annual_maintenance_pct=0.015 # 1.5% interior maintenance reserve\n",
        ")\n",
        "\n",
        "for key, val in jacobs_forecast.items():\n",
        "    print(f\"{key}: {val}\")"
      ]
    }
